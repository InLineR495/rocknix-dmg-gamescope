#
# Writes a flat hardware passport for the gamescope session, the way ArmadaOS
# does it in /usr/libexec/armada/device-env. The session file only translates
# these values into gamescope arguments, so adding a device means adding lines
# here and nothing else.
#
# Runs from /usr/bin/autostart, i.e. before `systemctl start ${UI_SERVICE}`.

. /etc/profile

RUNDIR=/var/run/gamescope
ENVFILE=${RUNDIR}/device-env

mkdir -p "${RUNDIR}"
rm -f "${ENVFILE}"

### Pick the card the display sits on.
card_no=$(ls /sys/class/drm/ | grep -E "DP|HDMI|DSI" | head -n 1 | cut -b 5)
card=/sys/class/drm/card${card_no}

### Scan connectors. Internal panel (DSI) is remembered separately, external
### outputs win when present so docking still works.
###
### Dual-screen caveat, and it is a real one: several SM8550 devices have two
### DSI panels (AYANEO Pocket DS, AYN Thor), and this whole platform now builds
### with gamescope, which drives ONE output. Those devices lose their second
### screen. Sorting makes the primary deterministic instead of whatever the
### directory glob happened to return last. Which DSI is the top panel is a
### per-device fact (Pocket DS: DSI-1, Thor: DSI-2!) and comes from the device
### table below, not from this scan.
dsi=""
external=""
for connector in $(ls -d ${card}/card${card_no}*/ 2>/dev/null | sort); do
    [ -e "${connector}/status" ] || continue
    [ "$(cat "${connector}/status")" = "connected" ] || continue
    con=$(basename "${connector}")
    con=${con: +6}
    case "${con}" in
        DSI*) [ -z "${dsi}" ] && dsi="${con}" ;;
        *)    external="${con}" ;;
    esac
done

### Preference order handed to gamescope -O: external first, panel as fallback.
if [ -n "${external}" ] && [ -n "${dsi}" ]; then
    GS_OUTPUTS="${external},${dsi}"
    GS_CONNECTOR="${external}"
elif [ -n "${external}" ]; then
    GS_OUTPUTS="${external}"
    GS_CONNECTOR="${external}"
else
    GS_OUTPUTS="${dsi}"
    GS_CONNECTOR="${dsi}"
fi

### Panel geometry, straight from the connector's mode list. These are the
### *physical* numbers; gamescope rotates on top of them.
GS_WIDTH=""
GS_HEIGHT=""
modes=${card}/card${card_no}-${GS_CONNECTOR}/modes
if [ -r "${modes}" ]; then
    mode=$(head -n 1 "${modes}")
    GS_WIDTH=${mode%x*}
    GS_HEIGHT=${mode#*x}
fi

### Rotation. sway derived this from the framebuffer console; gamescope wants
### the panel's mounting orientation instead, so the values are mapped rather
### than passed through.
###
### fbcon/rotate  sway transform  gamescope --force-orientation
###      0              0               normal
###      1             90               right
###      2            180               upsidedown
###      3            270               left
GS_ORIENTATION="normal"
if [ -n "${dsi}" ] && [ "${GS_CONNECTOR}" = "${dsi}" ]; then
    rot=$(cat /sys/class/graphics/fbcon/rotate 2>/dev/null)
    case "${rot}" in
        1) GS_ORIENTATION="right" ;;
        2) GS_ORIENTATION="upsidedown" ;;
        3) GS_ORIENTATION="left" ;;
        *) GS_ORIENTATION="normal" ;;
    esac
fi

### A rotated panel has no direct scanout path, so the output has to go through
### the rotation shader (patch 0005). Costs a pass, but it is the only way the
### image lands upright.
GS_ROTATION_SHADER=0
case "${GS_ORIENTATION}" in
    left|right|upsidedown) GS_ROTATION_SHADER=1 ;;
esac

### Refresh rate, only when the user pinned one. Otherwise let the panel driver
### decide, same as sway did.
GS_REFRESH=""
DISPLAY_MODE=$(get_setting system.display_mode)
if [ -n "${DISPLAY_MODE}" ]; then
    GS_REFRESH=$(echo "${DISPLAY_MODE}" | tr -cd '[[:digit:]].')
fi

### Physical panel size. Only needed where the panel driver lies about it.
GS_FAKE_OUTPUT_MM=""

### Per-device panel truth. Connector, native geometry and mounting orientation
### are lifted from ArmadaOS's device table (usr/lib/armada/devices/*.conf),
### which runs gamescope on these exact units - including AYN Thor, whose TOP
### panel is DSI-2 (mdss_dsi1), disproving the "first DSI is always the top
### panel" assumption the generic scan makes. Only the panel is described here;
### which output actually drives is decided after the case, so an external
### display keeps winning and docking still works.
PANEL_CONNECTOR=""
PANEL_WIDTH=""
PANEL_HEIGHT=""
PANEL_ORIENTATION=""
PANEL_FAKE_MM=""
case "${QUIRK_DEVICE}" in
    "AYANEO Pocket DMG")
        # Verified against ArmadaOS on this exact unit: DSI-1, 1080x1240 panel
        # mounted rotated. The panel driver reports width_mm=0 height_mm=0, so
        # gamescope derives a nonsense DPI from it; same fake value
        # start_steam.sh already uses here (Armada uses 177x100 - same aspect,
        # different Steam UI scale; check on the device which looks right).
        PANEL_CONNECTOR="DSI-1"; PANEL_WIDTH=1080;  PANEL_HEIGHT=1240
        PANEL_ORIENTATION="left";  PANEL_FAKE_MM="508x286"
        ;;
    "AYANEO Pocket ACE")
        PANEL_CONNECTOR="DSI-1"; PANEL_WIDTH=1080;  PANEL_HEIGHT=1620
        PANEL_ORIENTATION="right"
        ;;
    "AYANEO Pocket EVO")
        PANEL_CONNECTOR="DSI-1"; PANEL_WIDTH=1080;  PANEL_HEIGHT=1920
        PANEL_ORIENTATION="left"
        ;;
    "AYANEO Pocket DS")
        # Dual screen; DSI-1 is the top panel. The bottom one stays dark under
        # gamescope - accepted platform-wide tradeoff of this fork.
        PANEL_CONNECTOR="DSI-1"; PANEL_WIDTH=1080;  PANEL_HEIGHT=1920
        PANEL_ORIENTATION="left"
        ;;
    "AYN Odin 2")
        PANEL_CONNECTOR="DSI-1"; PANEL_WIDTH=1080;  PANEL_HEIGHT=1920
        PANEL_ORIENTATION="right"; PANEL_FAKE_MM="177x100"
        ;;
    "AYN Odin 2 Portal")
        PANEL_CONNECTOR="DSI-1"; PANEL_WIDTH=1080;  PANEL_HEIGHT=1920
        PANEL_ORIENTATION="left"
        ;;
    "AYN Thor")
        # Dual screen: top panel is DSI-2 (mdss_dsi1), bottom is DSI-1.
        PANEL_CONNECTOR="DSI-2"; PANEL_WIDTH=1080;  PANEL_HEIGHT=1920
        PANEL_ORIENTATION="right"
        ;;
esac

if [ -n "${PANEL_CONNECTOR}" ]; then
    if [ -n "${external}" ]; then
        ### Docked: the external display drives with its own scanned mode and
        ### no forced rotation; the panel stays as gamescope's fallback.
        GS_CONNECTOR="${external}"
        GS_OUTPUTS="${external},${PANEL_CONNECTOR}"
    else
        GS_CONNECTOR="${PANEL_CONNECTOR}"
        GS_OUTPUTS="${PANEL_CONNECTOR}"
        GS_WIDTH="${PANEL_WIDTH}"
        GS_HEIGHT="${PANEL_HEIGHT}"
        GS_ORIENTATION="${PANEL_ORIENTATION}"
        GS_ROTATION_SHADER=0
        case "${GS_ORIENTATION}" in
            left|right|upsidedown) GS_ROTATION_SHADER=1 ;;
        esac
        GS_FAKE_OUTPUT_MM="${PANEL_FAKE_MM}"
    fi
fi

{
    echo "GS_CONNECTOR=${GS_CONNECTOR}"
    echo "GS_OUTPUTS=${GS_OUTPUTS}"
    echo "GS_WIDTH=${GS_WIDTH}"
    echo "GS_HEIGHT=${GS_HEIGHT}"
    echo "GS_ORIENTATION=${GS_ORIENTATION}"
    echo "GS_ROTATION_SHADER=${GS_ROTATION_SHADER}"
    echo "GS_REFRESH=${GS_REFRESH}"
    echo "GS_FAKE_OUTPUT_MM=${GS_FAKE_OUTPUT_MM}"
} >"${ENVFILE}"

### Desktop mode used to be a second sway config. There is no desktop under
### gamescope, so the toggle is honoured by simply not claiming it worked.
if [ "$(get_setting desktop.enabled)" = "1" ]; then
    echo "gamescope session: desktop mode is not available without sway, staying in game mode"
    set_setting desktop.enabled "0"
fi

cat "${ENVFILE}"
