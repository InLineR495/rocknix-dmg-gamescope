. /etc/profile

TSKEY=$(get_setting "rocknix.touchscreen-keyboard.enabled")
if [ ! -n "${TSKEY}" ]; then
  if [ "$DEVICE_HAS_TOUCHSCREEN" == "true" ]; then
    set_setting "rocknix.touchscreen-keyboard.enabled" "1"
  else
    set_setting "rocknix.touchscreen-keyboard.enabled" "0"
  fi
fi


while true; do
  # This service starts at multi-user.target, long before the gamescope session
  # exists, and the one-shot `. /etc/profile` above therefore never sees a
  # WAYLAND_DISPLAY there - gamescope's socket is named gamescope-N and the
  # name is only published (and re-published on every session restart) through
  # the handshake file. Re-read it each pass; under sway the file simply never
  # exists and the statically exported wayland-1 keeps working as before.
  if [ -r /var/run/gamescope/env ]; then
    . /var/run/gamescope/env
    export DISPLAY WAYLAND_DISPLAY GAMESCOPE_WAYLAND_DISPLAY XDG_RUNTIME_DIR
  elif [ "$(compositor)" = "gamescope" ]; then
    # Session not up yet: spawning wvkbd now would just die against a socket
    # that is not there.
    sleep 5
    continue
  fi
  TSKEY=$(get_setting "rocknix.touchscreen-keyboard.enabled")
  if [[ "${DEVICE_HAS_TOUCHSCREEN}" == "true" ]] && [[ "${TSKEY}" == "1" ]]; then
    PID="$(pidof wvkbd-mobintl)"
    if [  "$PID" != ""  ]; then
      killall wvkbd-mobintl
    elif [[ "${DEVICE_HAS_DUAL_SCREEN}" == "true" ]] && [ "$(compositor)" = "sway" ]; then
      # Putting the keyboard on the second panel needs sway IPC to power that
      # output on and to name it. gamescope drives one output, so those devices
      # fall through to the single-screen branch below.
      secondary_output=$(swaymsg -t get_outputs -r | jq -r '.[] | select(.focused == false) | .name')
      swaymsg output ${secondary_output} power on
      if [[ ! "${QUIRK_DEVICE}" == "Anbernic RG DS" ]]; then
        tskb_height=720
        tskb_legend_size=32
      else
        tskb_height=350
        tskb_legend_size=18
      fi
      /usr/bin/wvkbd-mobintl -L ${tskb_height} -fg 6b6b75 -fg-sp 6b6b75 -bg 1d1d1d --text ffffff --text-sp ffffff -press 000000 --press-sp 000000  -fn ${tskb_legend_size} -l simple --hidden --output ${secondary_output}
    else
      /usr/bin/wvkbd-mobintl -H 400 -fg 6b6b75 -fg-sp 6b6b75 -bg 1d1d1d --text ffffff --text-sp ffffff -press 000000 --press-sp 000000 -fn 46 -l simple --hidden
    fi
  fi
  sleep 5
done
