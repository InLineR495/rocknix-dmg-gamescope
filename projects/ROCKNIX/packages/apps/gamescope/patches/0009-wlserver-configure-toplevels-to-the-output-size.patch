From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: c <a@b>
Date: Mon, 17 Aug 2026 18:20:00 +0300
Subject: [PATCH] wlserver: configure toplevels to the output size

Every game launched from the frontend came up in a small, blurry
rectangle instead of filling the panel, on a session that renders the
frontend itself perfectly.

The protocol trace from RetroArch shows the whole story:

  wl_output#4.mode(1240, 1080)                       <- output is fine
  wl_buffer#47 ... 1240, 1080                        <- so is the first swapchain
  -> xdg_toplevel#18.set_fullscreen(nil)
  xdg_toplevel#18.configure(0, 0, array[4])          <- 0x0, plus fullscreen
  -> xdg_surface#25.set_window_geometry(0, 0, 240, 256)
  wl_buffer#65 ... 240, 256                          <- content-sized fallback

0x0 in a configure means "client picks", which is fine in general but not
as an answer to a fullscreen request - wlroots calls that out as a
protocol violation in the request_fullscreen docs. RetroArch takes the
compositor at its word and sizes the surface from its own content, so a
240x256 buffer got stretched across the panel: soft, and letterboxed to
the content's aspect rather than the screen's. Measured against the
panel, the game filled 1013 of 1240 px.

Nothing here was ever exercised before, because gamescope resizes
Xwayland windows through steamcompmgr (XResizeWindow to root size) and
that is the path every Steam-based session uses. This session runs both
EmulationStation and the emulators as native Wayland clients - SDL2 is
built with VIDEO_X11=OFF - so they get xdg-shell instead, where
xdg_toplevel_new was an empty function and no size was ever sent.
EmulationStation escaped it only by sizing itself to wl_output already.

Send the size a toplevel will actually be shown at, both on the first
configure and whenever a client asks for fullscreen later - the latter
matters because the fullscreen round trip arrives well after the first
commit, and without it the client resizes itself back down.

--- a/src/steamcompmgr_shared.hpp
+++ b/src/steamcompmgr_shared.hpp
@@ -55,6 +55,7 @@
 	struct wl_listener map;
 	struct wl_listener unmap;
 	struct wl_listener destroy;
+	struct wl_listener request_fullscreen;
 };
 
 
--- a/src/wlserver.cpp
+++ b/src/wlserver.cpp
@@ -216,6 +216,42 @@
 	nudge_steamcompmgr();
 }
 
+// Configure a toplevel to the size we are actually going to show it at.
+//
+// xdg-shell lets a compositor answer with 0x0 to mean "pick your own size",
+// and that is what gamescope did for every toplevel, including ones that had
+// asked to go fullscreen. wlroots documents answering a fullscreen request as
+// mandatory ("not doing so is a protocol violation"), and clients act on it:
+// RetroArch sizes its surface from the configure, so 0x0 sent it down its
+// content-sized fallback instead of the output size.
+//
+// This is only reachable for native Wayland clients. Xwayland ones are resized
+// by steamcompmgr through XResizeWindow, which is why nothing needed it until
+// the session started running its frontend and emulators on Wayland directly.
+static void wlserver_toplevel_set_output_size( struct wlr_xdg_surface *pXdgSurface )
+{
+	if ( !pXdgSurface || !pXdgSurface->toplevel )
+		return;
+
+	wlr_xdg_toplevel_set_fullscreen( pXdgSurface->toplevel, true );
+	wlr_xdg_toplevel_set_size( pXdgSurface->toplevel, g_nNestedWidth, g_nNestedHeight );
+}
+
+// A client can ask for fullscreen long after its first commit, so the size has
+// to be repeated here - the first configure alone would leave the client
+// resizing itself back down on the fullscreen round trip.
+static void xdg_toplevel_request_fullscreen( struct wl_listener *listener, void *data )
+{
+	struct wlserver_xdg_surface_info *info =
+		wl_container_of( listener, info, request_fullscreen );
+
+	if ( !info->xdg_surface )
+		return;
+
+	wlserver_toplevel_set_output_size( info->xdg_surface );
+	wlr_xdg_surface_schedule_configure( info->xdg_surface );
+}
+
 void xwayland_surface_commit(struct wlr_surface *wlr_surface) {
 	wlr_surface->current.committed = 0;
 
@@ -227,7 +263,17 @@
 		if ( !wlserver_xdg_surface_info->bDoneConfigure )
 		{
 			if ( wlserver_xdg_surface_info->xdg_surface )
+			{
+				// A session shows exactly one window and always fills the
+				// output with it, so a toplevel needs to be told that size
+				// rather than left at the 0x0 ("you decide") default. A client
+				// that trusts the compositor to size a fullscreen surface -
+				// RetroArch does - otherwise falls back to its own content
+				// size and hands us a 240x256 buffer to stretch over the
+				// whole panel: soft, and letterboxed to the content's aspect.
+				wlserver_toplevel_set_output_size( wlserver_xdg_surface_info->xdg_surface );
 				wlr_xdg_surface_schedule_configure( wlserver_xdg_surface_info->xdg_surface );
+			}
 
 			if ( wlserver_xdg_surface_info->layer_surface )
 			{
@@ -1939,12 +1985,28 @@
 	wl_list_remove(&info->map.link);
 	wl_list_remove(&info->unmap.link);
 	wl_list_remove(&info->destroy.link);
+	// Initialised empty for every surface, so this is safe whether or not the
+	// surface ever took on a toplevel role.
+	wl_list_remove(&info->request_fullscreen.link);
 
 	wlserver_surface->xdg_surface = nullptr;
 }
 
 void xdg_toplevel_new(struct wl_listener *listener, void *data)
 {
+	struct wlr_xdg_toplevel *pToplevel = (struct wlr_xdg_toplevel *)data;
+
+	if ( !pToplevel || !pToplevel->base || !pToplevel->base->surface )
+		return;
+
+	wlserver_wl_surface_info *wlserver_surface = get_wl_surface_info( pToplevel->base->surface );
+	if ( !wlserver_surface || !wlserver_surface->xdg_surface )
+		return;
+
+	struct wlserver_xdg_surface_info *info = wlserver_surface->xdg_surface;
+
+	info->request_fullscreen.notify = xdg_toplevel_request_fullscreen;
+	wl_signal_add( &pToplevel->events.request_fullscreen, &info->request_fullscreen );
 }
 
 uint32_t get_appid_from_pid( pid_t pid );
@@ -1987,6 +2049,9 @@
 	wl_signal_add(&surface->events.map, &xdg_surface_info->map);
 	xdg_surface_info->unmap.notify = xdg_surface_unmap;
 	wl_signal_add(&surface->events.unmap, &xdg_surface_info->unmap);
+	// Only hooked up if this surface becomes a toplevel; keep the link valid so
+	// destroy can remove it unconditionally.
+	wl_list_init(&xdg_surface_info->request_fullscreen.link);
 
 	for (auto it = g_PendingCommits.begin(); it != g_PendingCommits.end();)
 	{
-- 
